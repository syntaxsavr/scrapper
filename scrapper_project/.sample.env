# ---- ENVIRONMENT ----
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=django-insecure-change-me-please

# ---- DJANGO ----
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- POSTGRES ----
DB_NAME=scrapper_db
DB_USER=scrapper_user
DB_PASSWORD=password123
DB_HOST=localhost
DB_PORT=5432

# ---- CELERY / REDIS ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- SENTRY ----
# Leave empty for development so Sentry won't initialize
SENTRY_DSN=

# Example for production:
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxx@oXXXXX.ingest.de.sentry.io/XXXXXXX
